# PrivdID Admin Backend — Environment Variables
# Copy to .env and fill in real values. Never commit a real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://localhost:27017/privdid

# --- Email (student credential delivery) ---
EMAIL_USER=CHANGE_ME

# --- IPFS (Pinata) ---
PINATA_JWT=CHANGE_ME

# --- Single-admin login (legacy, pre-Safe — D-09 lightweight password compare) ---
ADMIN_PASSWORD=CHANGE_ME

# --- Per-role official login (D-09, GOV-03) ---
# Lightweight plaintext-env password compare, mirroring ADMIN_PASSWORD exactly.
# NOT bcrypt/session infra — accepted interim auth posture (HARD-01 deferred).
ACADADMIN_PASSWORD=CHANGE_ME
REGISTRAR_PASSWORD=CHANGE_ME
DEAN_PASSWORD=CHANGE_ME

# --- JWT (role-login + requireAuth both depend on this) ---
JWT_SECRET=CHANGE_ME

# --- On-chain registry ---
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/CHANGE_ME
# PRIVATE_KEY remains the deployer EOA only (D-03) — it is NEVER an official
# Safe signer. Officials sign Safe transactions via MetaMask, never via a
# backend-held key.
PRIVATE_KEY=CHANGE_ME

# --- Gnosis Safe (E5 governance, GOV-02/03/04) ---
# SAFE_ADDRESS is the output of zk-proofs/scripts/deploySafe.js (09-01 local /
# 09-05 Sepolia deployment).
SAFE_ADDRESS=0x0000000000000000000000000000000000000000
SAFE_CHAIN_ID=11155111
SAFE_API_KEY=CHANGE_ME

# Expected Safe owner addresses (D-09 client-side owner-address match check
# in the Pending Approvals UI, plan 09-04).
SAFE_OWNER_ACADADMIN=0x0000000000000000000000000000000000000000
SAFE_OWNER_REGISTRAR=0x0000000000000000000000000000000000000000
SAFE_OWNER_DEAN=0x0000000000000000000000000000000000000000

# Local-Hardhat-only raw-key signer fallback for dev/testing. Hard-disabled
# whenever NODE_ENV=production (D-01/D-03) — never used for real Safe owners.
USE_LOCAL_SIGNERS=false
SAFE_LOCAL_SIGNER_KEY=CHANGE_ME

# --- E6 custodian custody (CUST-02, D-04/D-05) ---
# Paths where the backend reads custodian RSA-2048 PUBLIC PEMs for Shamir share
# wrapping. Real public PEMs come from the browser onboarding page
# (POST /api/custodians/register-key, D-10 — private key never leaves the device).
# Dev-only throwaway PEMs: node scripts/generateCustodianKeys.js
# Note: keys/*.pem is covered by the existing *.pem gitignore rule.
REGISTRAR_PUBLIC_KEY_PATH=./keys/registrar_public.pem
DEAN_PUBLIC_KEY_PATH=./keys/dean_public.pem
